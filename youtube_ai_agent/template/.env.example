# ── Agent Language ────────────────────────────────────────────────────────────
# Language your Telegram assistant speaks: english | italian
AGENT_LANGUAGE=english

# ── AI Service ────────────────────────────────────────────────────────────────
# Options: openrouter | openai | anthropic | gemini | mistral | groq | deepseek
#          xai | cohere | together | perplexity | fireworks | azure_openai
#          ollama_cloud | ollama_local
AI_SERVICE=openrouter

# OpenRouter (free tier available) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq (fast inference, free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# xAI (Grok) — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024

# Together AI — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Perplexity AI — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Fireworks AI — https://fireworks.ai/api-keys
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Azure OpenAI — https://portal.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-5.6-luna
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Ollama Cloud — https://ollama.com
OLLAMA_API_KEY=

# Ollama Local (no key needed)
OLLAMA_LOCAL_MODEL=llama3.2

PEXELS_API_KEY=your_pexels_key_here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Sorgente delle clip ───────────────────────────────────────────────────────
# Configurabile dalla TUI: `tube-assistant clips` (o voce "Video clips" nel menu).
#   pexels  clip stock scaricate da Pexels (gratis, default)
#   ibrido  l'AI genera le prime clip (l'aggancio), Pexels riempie il resto
#   ai      ogni clip generata dall'AI, nessun download
# Pexels resta la rete di sicurezza: se il provider AI e' giu' o senza credito
# la pipeline ripiega li' invece di produrre un video senza b-roll.
VIDEO_SOURCE=pexels
# replicate | fal | luma | openrouter
# openrouter non ha modelli text-to-video: genera un'IMMAGINE della scena e la
# clip viene montata in locale con un movimento di camera (ffmpeg). Costa una
# frazione di un modello video e riusa la chiave gia' usata per gli script.
VIDEO_AI_PROVIDER=replicate
REPLICATE_API_TOKEN=
FAL_KEY=
LUMA_API_KEY=
# OPENROUTER_API_KEY e' la stessa della sezione AI service, piu' in alto.
# Modello del provider. Vuoto = default del provider (Replicate:
# wan-video/wan-2.1-t2v-480p, fal: fal-ai/ltx-video, Luma: ray-flash-2,
# OpenRouter: google/gemini-2.5-flash-image — dev'essere un modello con
# output image, un modello solo testo non produce clip).
VIDEO_AI_MODEL=
# TETTO DI SPESA: quante clip generare per video. Un video da 8 minuti sono
# ~96 segmenti da 5s: senza tetto una sola pubblicazione costa moltissimo.
VIDEO_AI_MAX_CLIPS=6
# secondi di attesa per clip, e quante generarne in parallelo
VIDEO_AI_TIMEOUT=420
VIDEO_AI_PARALLELE=2
# Le clip generate sono costate soldi: cache con tetto SEPARATO da quella Pexels
MAX_AI_CACHE_MB=3000

# ── Thumbnail image generation ────────────────────────────────────────────────
# Provider for the AI background image: pollinations | huggingface | openrouter
# Fallback chain runs the others automatically; final fallback is a local gradient.
IMAGE_PROVIDER=pollinations
# HuggingFace token (FLUX.1-schnell) — https://huggingface.co/settings/tokens
HF_API_KEY=
# Pollinations free token (lifts anonymous queue limit) — https://enter.pollinations.ai
POLLINATIONS_TOKEN=

# FFmpeg path override (leave empty to use system PATH)
FFMPEG_PATH=

# Raspberry/low-power rendering. "auto" enables lighter settings on ARM boards.
PI_SAFE_MODE=auto
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
FFMPEG_THREADS=2
X264_PRESET=ultrafast
X264_CRF=28
USE_FFMPEG_RENDER=auto

# ── Audio di consegna ─────────────────────────────────────────────────────────
# YouTube normalizza a circa -14 LUFS: consegnare piu' piano non fa alzare il
# volume, fa solo suonare il video piu' debole degli altri nel feed. Il mp3 di
# edge-tts arriva a -26 dB, mono a 24 kHz, e senza questi valori usciva cosi'.
AUDIO_LUFS=-14
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
AUDIO_BITRATE=192k

# Mostra solo poche frasi importanti pronunciate nel video.
VIDEO_CAPTIONS=1
MAX_KEY_CAPTIONS=8
CAPTION_FONT_SIZE=42
CAPTION_MIN_GAP_SECONDS=12

# ── Encoder video ─────────────────────────────────────────────────────────────
# Codec forzato (salta il rilevamento GPU): libx264 | h264_nvenc | h264_amf | h264_qsv
# Lascia vuoto per rilevarlo automaticamente. Il rilevamento prova l'encoder
# alla risoluzione reale di output e lo scarta se si blocca.
VIDEO_CODEC=
# Segmenti renderizzati in parallelo. 0 = automatico (1 su ARM, 2 con GPU,
# CPU/FFMPEG_THREADS altrimenti).
RENDER_WORKERS=0
# Timeout di sicurezza in secondi: un ffmpeg bloccato non deve appendere il daemon
SEGMENT_TIMEOUT=180
FFMPEG_TIMEOUT=1800
GPU_PROBE_TIMEOUT=25

# ── Limiti AI ─────────────────────────────────────────────────────────────────
# Tetto di token in output. Alzalo se generi video molto lunghi e il JSON
# dello script arriva troncato; abbassalo per risparmiare sui provider a pagamento.
AI_MAX_TOKENS=8192
# Temperatura della chat di controllo su Telegram (bassa = risposte precise).
# La pipeline creativa usa comunque una temperatura alta per variare i contenuti.
AI_CHAT_TEMPERATURE=0.3

# ── YouTube ───────────────────────────────────────────────────────────────────
# Categoria dei video caricati (28 = Science & Technology, 27 = Education,
# 24 = Entertainment, 22 = People & Blogs)
YOUTUBE_CATEGORY_ID=28

# Modello Ollama Cloud (era cablato nel codice). Modelli free noti:
#   nemotron-3-super  nemotron-3-nano:30b  gemma4:31b  nemotron-3-ultra
# ATTENZIONE: gpt-oss:20b e gpt-oss:120b sono modelli "reasoning" che
# restituiscono il testo in `thinking` e lasciano `content` vuoto — usali
# solo alzando AI_MAX_TOKENS, altrimenti la risposta arriva vuota.
OLLAMA_CLOUD_MODEL=nemotron-3-super:cloud

# Ritmo di lettura stimato per convertire durata_target_minuti in parole.
# Misurato su Edge TTS: 147-159 parole/min. Abbassalo per voci piu' lente.
PAROLE_AL_MINUTO=150
